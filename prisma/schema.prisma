// ServisHub SK — core marketplace schema
// Prisma Client output: src/generated/prisma
// RLS policies live in supabase/migrations (enforced for Supabase client; Prisma uses service role / direct connection)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderTier {
  FREE
  PRO
  PREMIUM
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

/// App profile 1:1 with Supabase auth.users (id = auth.users.id)
model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id") // auth.users.id (UUID)
  email     String   @unique
  fullName  String?  @map("full_name")
  phone     String?
  role      UserRole @default(CUSTOMER)
  avatarUrl String?  @map("avatar_url")
  locale    String   @default("sk")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  provider  Provider?
  bookings  Booking[] @relation("CustomerBookings")
  reviews   Review[]  @relation("CustomerReviews")
  leads     Lead[]    @relation("CustomerLeads")

  @@index([role])
  @@map("profiles")
}

model Provider {
  id                 String             @id @default(cuid())
  profileId          String             @unique @map("profile_id")
  businessName       String             @map("business_name")
  slug               String             @unique
  bio                String?
  ico                String?
  dic                String?
  city               String?
  postalCode         String?            @map("postal_code")
  tier               ProviderTier       @default(FREE)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  insuranceVerified  Boolean            @default(false) @map("insurance_verified")
  ratingAvg          Float              @default(0) @map("rating_avg")
  ratingCount        Int                @default(0) @map("rating_count")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  profile       Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  services      Service[]
  serviceAreas  ServiceArea[]
  availability  Availability[]
  bookings      Booking[]
  reviews       Review[]
  subscription  Subscription?
  leads         Lead[]

  @@index([city])
  @@index([tier])
  @@index([verificationStatus])
  @@index([isActive, ratingAvg])
  @@map("providers")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  services Service[]

  @@map("categories")
}

model Service {
  id          String   @id @default(cuid())
  providerId  String   @map("provider_id")
  categoryId  String   @map("category_id")
  title       String
  description String?
  priceFrom   Decimal? @map("price_from") @db.Decimal(10, 2)
  priceTo     Decimal? @map("price_to") @db.Decimal(10, 2)
  currency    String   @default("EUR")
  durationMin Int?     @map("duration_min")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  bookings Booking[]

  @@index([providerId])
  @@index([categoryId])
  @@index([isActive])
  @@map("services")
}

model ServiceArea {
  id         String   @id @default(cuid())
  providerId String   @map("provider_id")
  city       String
  postalCode String?  @map("postal_code")
  radiusKm   Int?     @map("radius_km")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([postalCode])
  @@index([providerId])
  @@map("service_areas")
}

/// Weekly recurring availability window (0 = Sunday … 6 = Saturday)
model Availability {
  id         String   @id @default(cuid())
  providerId String   @map("provider_id")
  dayOfWeek  Int      @map("day_of_week")
  startTime  String   @map("start_time") // HH:mm
  endTime    String   @map("end_time") // HH:mm
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, dayOfWeek])
  @@map("availability")
}

model Booking {
  id           String        @id @default(cuid())
  customerId   String        @map("customer_id")
  providerId   String        @map("provider_id")
  serviceId    String?       @map("service_id")
  status       BookingStatus @default(PENDING)
  scheduledAt  DateTime      @map("scheduled_at")
  durationMin  Int?          @map("duration_min")
  addressLine  String?       @map("address_line")
  city         String?
  postalCode   String?       @map("postal_code")
  notes        String?
  priceAmount  Decimal?      @map("price_amount") @db.Decimal(10, 2)
  currency     String        @default("EUR")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  customer Profile  @relation("CustomerBookings", fields: [customerId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])
  service  Service? @relation(fields: [serviceId], references: [id])
  review   Review?

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledAt])
  @@index([city])
  @@map("bookings")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique @map("booking_id")
  customerId String   @map("customer_id")
  providerId String   @map("provider_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer Profile  @relation("CustomerReviews", fields: [customerId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([rating])
  @@map("reviews")
}

model Subscription {
  id                   String             @id @default(cuid())
  providerId           String             @unique @map("provider_id")
  tier                 ProviderTier       @default(FREE)
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}

model Lead {
  id          String     @id @default(cuid())
  customerId  String?    @map("customer_id")
  providerId  String?    @map("provider_id")
  categoryId  String?    @map("category_id")
  status      LeadStatus @default(NEW)
  source      String?
  city        String?
  message     String?
  contactName String?    @map("contact_name")
  contactEmail String?   @map("contact_email")
  contactPhone String?   @map("contact_phone")
  unlockedAt  DateTime?  @map("unlocked_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  customer Profile?  @relation("CustomerLeads", fields: [customerId], references: [id])
  provider Provider? @relation(fields: [providerId], references: [id])

  @@index([status])
  @@index([city])
  @@index([providerId])
  @@map("leads")
}
